# Disable GPS & GPS Simulation
GPS1_TYPE 0
SIM_GPS1_ENABLE 0
SIM_GPS1_TYPE 0

# External Navigation / Visual Odometry (MAVLink #331)
VISO_TYPE 1
VISO_DELAY_MS 50

# EKF3 Source Set 1 (Indoor GPS-Denied: LiDAR VelXY + Rangefinder Alt)
EK3_SRC1_POSZ 1
EK3_SRC1_YAW 1
EK3_SRC1_POSXY 0
EK3_SRC1_VELXY 0

# Arming & Pre-Arm Check Configuration
ARMING_NEED_LOC 0
ARMING_SKIPCHK 65535

# EKF3 Global Setup
AHRS_EKF_TYPE 3
EK3_ENABLE 1

# Without this param , drone is wobbly
ATC_RAT_RLL_D 0.001
# Frame 
FRAME_CLASS 1
FRAME_TYPE 1
