# NIDAR Airmouse — indoor / no-GPS ArduPilot parameters for SITL
# Load with: sim_vehicle.py ... --add-param-file=/workspace/SIM/config/x3_no_gps.parm

# Disable GPS hardware/driver (matches have_gps=0 in model.sdf)
GPS_TYPE,0

# EKF3: no horizontal position/velocity from GPS; use baro + compass only
EK3_ENABLE,1
EK3_SRC1_POSXY,0
EK3_SRC1_VELXY,0
EK3_SRC1_POSZ,2
EK3_SRC1_VELZ,0
EK3_SRC1_YAW,1

# Secondary sources also off (no GPS fallback)
EK3_SRC2_POSXY,0
EK3_SRC2_VELXY,0
EK3_SRC2_POSZ,0
EK3_SRC2_VELZ,0
EK3_SRC2_YAW,0

# Allow arming without GPS lock during sim bring-up (tighten before competition)
ARMING_CHECK,786424

# Indoor-friendly defaults
COMPASS_ENABLE,1
BARO_ENABLE,1

# When SLAM/external nav is ready, switch to:
# EK3_SRC1_POSXY,6   (ExternalNav)
# EK3_SRC1_VELXY,6   (ExternalNav)
# VISO_TYPE,1
