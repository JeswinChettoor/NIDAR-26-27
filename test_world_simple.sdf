<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cpu_lidar_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core physics & user command systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    
    <!-- Standard sensors system (handles CPU lidar raycasting) -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <!-- GUI Configuration -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <scene>scene</scene>
        <camera_pose>-3.5 0.0 3.0 0 0.55 0.0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="WorldControl" name="World control"/>
      <plugin filename="WorldStats" name="World stats"/>
      <plugin filename="VisualizeLidar" name="Visualize Lidar"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Directly in Front (+X, 2.0m away) -->
    <model name="front_obstacle">
      <static>true</static>
      <pose>2.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.2 1.0</size></box></geometry>
          <material>
            <ambient>1.0 0.1 0.1 1</ambient>
            <diffuse>1.0 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle to the Left (+Y, 1.5m away) -->
    <model name="left_obstacle">
      <static>true</static>
      <pose>0.0 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle to the Right (-Y, 1.5m away) -->
    <model name="right_obstacle">
      <static>true</static>
      <pose>0.0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.1 0.3 1.0 1</ambient>
            <diffuse>0.1 0.3 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- CPU-Based 2D LiDAR Model -->
    <model name="cpu_lidar_sensor">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>

      <link name="lidar_link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.15</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.0 1</ambient>
            <diffuse>0.9 0.9 0.0 1</diffuse>
          </material>
        </visual>

        <!-- Changed type to "lidar" (CPU raycasting) -->
        <sensor name="cpu_lidar" type="lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>20</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
