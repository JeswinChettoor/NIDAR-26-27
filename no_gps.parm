# Frame Configuration (Quad X)
FRAME_CLASS 1
FRAME_TYPE 1

# Disable GPS & GPS Simulation
GPS1_TYPE 0
SIM_GPS1_ENABLE 0
SIM_GPS1_TYPE 0

# EKF3 Global Setup
AHRS_EKF_TYPE 3
EK3_ENABLE 1

# EKF3 Source Set 1 (Merged from Config 1)
EK3_SRC1_POSXY 0
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 1
EK3_SRC1_YAW 1
EK3_SRC_OPTIONS 0

# Arming & Checks
ARMING_NEED_LOC 0

# Attitude Rate PID Tuning
ATC_RAT_RLL_P 0.10
ATC_RAT_RLL_I 0.10
ATC_RAT_RLL_D 0.001
ATC_RAT_PIT_P 0.10
ATC_RAT_PIT_I 0.10
ATC_RAT_PIT_D 0.001
ATC_RAT_YAW_P 0.15
ATC_RAT_YAW_I 0.015
ATC_RAT_YAW_D 0.000
