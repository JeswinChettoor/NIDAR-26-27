# --- SITL Loop Rate & Safety ---
ARMING_CHECK 0
ARMING_NEED_LOC 0
SCHED_LOOP_RATE 250



# --- External Navigation / Odometry via MAVROS ---
VISO_TYPE 1
VISO_DELAY_MS 10

# --- Rangefinder Disabled ---
RNGFND1_TYPE 0

# --- EKF3 Fusion Pipeline (Indoor GPS-Denied, Baro Alt, Compass Yaw) ---
AHRS_EKF_TYPE 3
EK3_ENABLE 1
# External position and velocity from rf2o (sets home origin & motion tracking)
EK3_SRC1_POSXY 0
EK3_SRC1_VELXY 6
# Barometer altitude
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 0
# Compass heading
EK3_SRC1_YAW 1

# --- Vehicle Frame & Tuning ---
FRAME_CLASS 1
FRAME_TYPE 1
ATC_RAT_RLL_D 0.001
